// TrP Tools — English source strings for the Discord bot
//
// Everything the bot says in Discord. The website's words live in
// strings.jsonc beside this; they are separate files because they are
// separate products with separate release cycles, and because a translator
// working on the bot is reading Discord messages rather than web pages.
//
// It is JSONC: comments are for you and are stripped when the bot is built,
// so write as many as help.
//
// Translating:
//   * Change only the text on the right of the colon. The key on the left
//     is what the code looks the string up by — rename one and the bot
//     loses that string.
//   * Keep every {placeholder} exactly as spelled. They are filled in when
//     the message is sent, with names, counts, channels and times. You may
//     move them around the sentence to suit your language.
//   * A missing key falls back to English, so a partial translation is
//     useful and safe to submit.
//
// Two things to know about how these are shown:
//
//   * A group picks **several** languages, in order, and the bot renders
//     each message in every one of them — a title comes out as
//     "Upcoming shift / Наступна зміна". Keep titles and labels short;
//     they are joined end to end.
//   * Discord's own markup works: `**bold**`, `<#123>` is a channel,
//     `<@&123>` a role, `<t:1700000000:R>` a time in the reader's own
//     timezone. Anything in that shape is generated — copy it across
//     untouched.

{
	"$schema": "https://inlang.com/schema/inlang-message-format",

	// ─── command ─────────────────────────────────────────────────
	// What Discord shows in the slash-command menu. Discord picks one of
	// these by the reader's own client language rather than the group's
	// list, so these are never joined together.
	//
	// The command *names* are deliberately not here: they are what somebody
	// types, they must be lowercase ASCII, and a translated `/begin` would
	// make every guide to the bot wrong.
	"bot_command_announce_description": "Announce the next scheduled shift in the announcements channel.",
	"bot_command_begin_description": "Announce publicly that the shift is starting.",
	"bot_command_complete_description": "Close out the shift: clear its sign-up sheets and ask how it went.",
	"bot_command_edit_shift_description": "Set the note and server owner shown on the next shift announcement.",
	"bot_command_option_code_description": "The private server join code, if you have one.",
	"bot_command_ping_description": "Check that the bot can reach Discord and TrP Tools.",
	"bot_command_signups_description": "Post the staff sign-up sheets for the next shift.",
	"bot_command_staff_begin_description": "Tell the staff who signed up that the server is open, before announcing it publicly.",
	"bot_command_status_description": "Show what this server is configured to do, and what is coming up.",

	// ─── common ──────────────────────────────────────────────────
	// The heading on every refusal, and the answers the bot gives when it
	// cannot get as far as the command itself.
	"bot_common_cannot_do_that": "Cannot do that",
	"bot_common_not_set": "not set",
	"bot_common_server_only": "This command only works inside a server.",
	"bot_common_not_connected": "This server is not connected to a TrP Tools group yet. A group manager can add the bot from the Bot page in the dashboard.",
	"bot_common_unhandled": "Something went wrong handling that. It has been logged.",
	// Shown in a sheet in place of a mention, for somebody who signed up on
	// the website and has no Discord account linked.
	"bot_common_someone_on_the_website": "Someone on the website",
	"bot_common_view_on_the_website": "View on the website",

	// ─── reason ──────────────────────────────────────────────────
	// Why something the bot tried did not happen. Each is a fragment shown
	// inside a longer sentence, so it starts lowercase and has no full stop.
	"bot_reason_no_announcement_channel": "no shift announcement channel the bot can post in",
	"bot_reason_no_host_channel": "no host channel the bot can post in",
	"bot_reason_discord_refused": "Discord refused the message",
	"bot_reason_no_channel_set": "no channel set",
	"bot_reason_cannot_post_in_channel": "the bot cannot post in its channel",
	"bot_reason_no_slots": "no slots configured",
	"bot_reason_nobody_signed_up": "nobody signed up",

	// ─── announce ────────────────────────────────────────────────
	// The "a shift is coming up" post, and the "we are open now" post that
	// carries the join link.
	"bot_announce_upcoming_title": "Upcoming shift",
	// {name} is the shift's name. {at} and {relative} are both generated
	// times — copy them across untouched.
	"bot_announce_upcoming_body": "**{name}** is scheduled for {at} ({relative}).",
	// {name} is the shift's name.
	"bot_announce_start_title": "{name} is starting",
	// {link} is the Roblox join link. Keep the [text](link) shape: Discord
	// draws it as a link, and translating only the text is the point.
	"bot_announce_start_join": "[Click here to join]({link})",
	// The same sentence when the group publishes the code as text as well.
	"bot_announce_start_join_with_code": "[Click here to join]({link}), or use the code **{code}**",
	"bot_announce_start_servers_menu": "You can also join through the servers menu in game.",
	"bot_announce_start_ends": "Ends",
	"bot_announce_host_title": "A shift needs a host",
	"bot_announce_host_body": "**{name}** starts {relative} ({at}).",
	"bot_announce_host_open_the_room": "Open the dispatch room and start the server when you are ready.",

	// ─── staff ───────────────────────────────────────────────────
	// Letting the people who claimed a slot into the server, ahead of the
	// public announcement. Posted in each sign-up sheet's own channel.
	// {sheet} is the sheet's name, which the group wrote.
	"bot_staff_title": "{sheet} — the server is open",
	"bot_staff_running_now": "**{name}** is running now.",
	"bot_staff_starting_soon": "**{name}** starts {relative}. You are on it, so come in and get set up.",
	"bot_staff_footer_running": "Please keep the join code to the staff on this shift.",
	"bot_staff_footer_early": "You are in before the public announcement — please keep the code to yourselves.",

	// ─── sheet ───────────────────────────────────────────────────
	// A rank's sign-up sheet, as a message people pick a slot from.
	"bot_sheet_title": "{sheet} — sign-ups",
	"bot_sheet_starts": "**{name}** starts {at} ({relative})",
	"bot_sheet_how_to": "Pick a slot below, or sign up on the website. Both stay in step.",
	// Shown under a slot nobody has taken. The asterisks make Discord draw
	// it in italics — keep them.
	"bot_sheet_empty": "*Empty*",
	// {slot} is the slot's name; {taken} and {capacity} are numbers.
	"bot_sheet_slot_heading": "{slot} ({taken}/{capacity})",
	"bot_sheet_slot_full": "{slot} (full)",
	"bot_sheet_slot_taken_count": "{taken}/{capacity} taken",
	"bot_sheet_placeholder": "Choose a slot, or pick yours again to drop it",
	"bot_sheet_sign_up_on_website": "Sign up on the website",
	"bot_sheet_footer": "{group} · sign-ups update live",

	// ─── signup ──────────────────────────────────────────────────
	// The private answer somebody gets after picking a slot.
	"bot_signup_signed_up": "Signed up",
	"bot_signup_signed_off": "Signed off",
	"bot_signup_taken": "You have the **{slot}** slot.",
	"bot_signup_moved": "Moved you from **{previous}** to **{slot}**.",
	"bot_signup_released": "You have given up the **{slot}** slot.",
	"bot_signup_full": "**{slot}** is already full. Pick another.",
	"bot_signup_gone": "That slot no longer exists — the sheet was changed.",
	"bot_signup_sheet_invalid": "That sign-up sheet is no longer valid. Ask for a fresh one.",
	"bot_signup_group_gone": "This server is not connected to a TrP Tools group any more.",
	"bot_signup_no_answer": "TrP Tools did not answer. Try again in a moment.",

	// ─── nothing ─────────────────────────────────────────────────
	// A command that has nothing to act on. {link} is an address on the
	// website — copy it across untouched.
	"bot_nothing_to_start": "There is no shift running or coming up, so there is nothing to start. Add one at {link}.",
	"bot_nothing_to_let_in": "There is no shift running or coming up, so there is nobody to let in. Add one at {link}.",
	"bot_nothing_to_edit": "There is no shift running or coming up to edit. Add one at {link}.",
	"bot_nothing_to_close": "There is no shift to close out. Nothing is running, and nothing is scheduled — check the schedule at {link}.",
	"bot_nothing_to_announce": "There is no upcoming shift to announce. Add one at {link}.",
	"bot_nothing_to_open_signups_for": "There is no upcoming shift to open sign-ups for. Add one at {link}.",

	// ─── off ─────────────────────────────────────────────────────
	// A feature the group has switched off on the website.
	"bot_off_announcements": "Shift announcements are switched off for this group. Turn them on at {link}.",
	"bot_off_announcements_nothing_posted": "Shift announcements are switched off for this group, so nothing was posted. Turn them on at {link}.",
	"bot_off_signups": "Sign-up sheets are switched off for this group. Turn them on at {link}.",
	"bot_off_signups_nobody": "Sign-up sheets are switched off for this group, so there is nobody to let in. Turn them on at {link}.",

	// ─── announce_command ────────────────────────────────────────
	"bot_announce_command_announced_title": "Shift announced",
	// {channel} is generated and draws as a link to the channel.
	"bot_announce_command_announced_body": "**{name}** on {at} was announced in {channel}.",
	// {reason} is one of the bot_reason_* fragments above.
	"bot_announce_command_failed": "Could not announce it: {reason}.",
	"bot_announce_command_check_channel": "Set the announcement channel at {link}, and check the bot can send messages and embed links there.",

	// ─── begin ───────────────────────────────────────────────────
	"bot_begin_started_title": "{name} has started",
	"bot_begin_failed": "Could not announce the start: {reason}.",
	"bot_begin_announced_in": "Announced in {channel}.",
	"bot_begin_staff_already_in": "Staff who signed up were already let in.",
	"bot_begin_staff_not_in": "Staff who signed up have not been let in — run `/staff-begin` to do that.",
	"bot_begin_board_posted": "Posted the live dispatch board.",
	"bot_begin_board_waiting": "No dispatch room is open yet — the board will appear once one is.",

	// ─── staff_begin ─────────────────────────────────────────────
	"bot_staff_begin_title": "Staff are in for {name}",
	"bot_staff_begin_no_signups_read": "Could not read the sign-ups for this shift. Try again in a moment.",
	"bot_staff_begin_no_sheets": "No rank has a sign-up sheet, so nobody could have signed up. Sign-ups are per rank — add one at {link}.",
	"bot_staff_begin_nobody_let_in": "Nobody was let in:",
	"bot_staff_begin_where_sheets_post": "Sheets post to the channel set on each rank at {link}.",
	"bot_staff_begin_told": "Told sign-ups in: {sheets}.",
	"bot_staff_begin_skipped": "Skipped: {sheets}.",
	"bot_staff_begin_no_code": "No join code was given, so the link points at the group’s default server.",
	"bot_staff_begin_announce_at": "The public announcement is still to come — run `/begin` at {at}.",
	"bot_staff_begin_announce_when_ready": "Run `/begin` when you are ready to announce it publicly.",
	// One entry in the "nobody was let in" list. {sheet} is the sheet's
	// name; {reason} is one of the bot_reason_* fragments.
	"bot_staff_begin_skipped_entry": "{sheet} ({reason})",

	// ─── signups ─────────────────────────────────────────────────
	"bot_signups_open_title": "Sign-ups are open",
	"bot_signups_open_body": "For **{name}** on {at}.",
	"bot_signups_not_yet": "Sign-ups for **{name}** open {relative} ({at}).",
	"bot_signups_change_lead": "Change how far ahead they open in group settings on the website.",
	"bot_signups_no_sheets": "No rank has a sign-up sheet set up yet. Sign-ups are per rank — add one at {link}.",
	"bot_signups_none_posted": "No sheet could be posted:",
	"bot_signups_not_posted": "Not posted",
	// One line of the list above. {sheet} is a sheet's name; {reason} is one
	// of the bot_reason_* fragments.
	"bot_signups_skipped_entry": "**{sheet}** — {reason}",

	// ─── complete ────────────────────────────────────────────────
	"bot_complete_title": "{name} is closed out",
	"bot_complete_title_problems": "{name} closed out, with problems",
	"bot_complete_nothing_to_clear": "There was nothing left to clear.",
	"bot_complete_clearing_off": "Clearing is switched off for every channel this shift posted in.",
	// {removed} and {considered} are counts.
	"bot_complete_cleared": "Cleared {removed} of {considered} messages.",
	"bot_complete_cleared_one": "Cleared {removed} of 1 message.",
	"bot_complete_kept": "Left {kept} alone — those channels are set to keep their messages at {link}.",
	// {where} is a list of channels, already drawn as links.
	"bot_complete_blocked": "Could not delete {failed} of them in {where} — the bot needs **Manage Messages** and **Read Message History** there. Fix that and run `/complete` again; the messages are still tracked, so nothing is stranded.",
	"bot_complete_poll_posted": "Posted the feedback poll in {channel}.",
	"bot_complete_polls_off": "Polls are switched off for this group.",
	"bot_complete_no_poll_channel": "No poll channel is set, so no poll was posted.",
	"bot_complete_poll_failed": "Could not post the poll in {channel} — check the bot can send messages and create polls there.",

	// ─── poll ────────────────────────────────────────────────────
	// The post-shift satisfaction poll. Discord allows one question and one
	// set of answers per poll, so these are shown in the group's first
	// language only — keep them short.
	"bot_poll_question": "{name} — {date}",
	"bot_poll_loved_it": "I loved it",
	"bot_poll_liked_it": "I liked it",
	"bot_poll_could_be_better": "It could be better",
	"bot_poll_did_not_like_it": "I did not like it",
	"bot_poll_hated_it": "I hated it",

	// ─── manifest ────────────────────────────────────────────────
	// The picture of the dispatch board, posted under a start announcement.
	"bot_manifest_title": "Dispatch board",
	"bot_manifest_footer": "Updates while the room is open",

	// ─── edit_shift ──────────────────────────────────────────────
	// The form a host fills in to set a note and a server for one shift.
	// Discord caps a modal title at 45 characters and a field label at 45,
	// so keep these short — anything longer is cut off.
	"bot_edit_shift_modal_title": "Edit {name}",
	"bot_edit_shift_note_label": "Shift note",
	"bot_edit_shift_note_placeholder": "Shown alongside the announcement. Leave blank for none.",
	"bot_edit_shift_owner_label": "Server owner Roblox ID",
	"bot_edit_shift_owner_placeholder": "Leave blank to use the group owner’s server.",
	"bot_edit_shift_owner_not_a_number": "The server owner has to be a Roblox user ID — digits only.",
	"bot_edit_shift_refused": "TrP Tools did not accept that. Try again.",
	"bot_edit_shift_saved_title": "Shift updated",
	"bot_edit_shift_saved_note": "**Note**\n{note}",
	"bot_edit_shift_saved_no_note": "No note will be shown.",
	"bot_edit_shift_saved_owner": "**Server owner**\n`{owner}`",
	"bot_edit_shift_saved_default_owner": "Using the group owner’s server.",

	// ─── ping ────────────────────────────────────────────────────
	"bot_ping_pinging": "Pinging…",
	"bot_ping_title": "Pong",
	"bot_ping_roundtrip": "Discord roundtrip: **{ms}ms**",
	"bot_ping_api_reachable": "TrP Tools: **reachable** ({ms}ms)",
	"bot_ping_api_unreachable": "TrP Tools: **not answering for this server**",
	"bot_ping_connected_to": "Connected to **{group}**",
	"bot_ping_not_connected": "Either this server is not connected to a group yet, or the API is down.",

	// ─── status ──────────────────────────────────────────────────
	// What the bot believes it is set up to do, answered inside Discord.
	"bot_status_title": "Connected to {group}",
	"bot_status_open_dashboard": "[Open the dashboard]({link})",
	"bot_status_channels": "Channels",
	"bot_status_announcements": "Announcements",
	"bot_status_polls": "Polls",
	"bot_status_host": "Host",
	"bot_status_roles": "Roles",
	"bot_status_shift_ping": "Shift ping",
	"bot_status_host_ping": "Host ping",
	"bot_status_features": "Features",
	"bot_status_feature_announcements": "Announcements",
	"bot_status_feature_signups": "Sign-up sheets",
	"bot_status_feature_polls": "Polls",
	"bot_status_feature_reminders": "Reminders",
	"bot_status_feature_manifest": "Live manifest",
	"bot_status_automation": "Automation",
	"bot_status_auto_announce": "Announce upcoming",
	"bot_status_auto_signups": "Post sign-ups",
	"bot_status_auto_host_reminder": "Remind the host",
	"bot_status_auto_staff_start": "Let staff in",
	"bot_status_auto_begin": "Announce the start",
	"bot_status_auto_complete": "Close out",
	// {minutes} is a number.
	"bot_status_minutes_before": "{minutes} min before",
	"bot_status_minutes_after_end": "{minutes} min after the end",
	// {label} is one of the six automation names above; {when} is one of the
	// two lines above it.
	"bot_status_automation_on": "{label} — {when}",
	"bot_status_sheets": "Sign-up sheets",
	// {sheet} and {rank} are names the group wrote; {channel} is generated;
	// {slots} is a number.
	"bot_status_sheet_line": "**{sheet}** ({rank}+) → {channel} · {slots} slots",
	"bot_status_sheet_line_one": "**{sheet}** ({rank}+) → {channel} · 1 slot",
	"bot_status_no_sheets": "*None set up. Add one per rank on the Ranks page.*",
	"bot_status_shifts": "Shifts",
	"bot_status_running_now": "Running now: **{name}**, ends {relative}",
	"bot_status_nothing_running": "Nothing running now",
	"bot_status_next": "Next: **{name}** {relative}",
	"bot_status_nothing_scheduled": "Nothing scheduled"
}
